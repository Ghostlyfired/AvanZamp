# Deployment template only. Replace all placeholders before starting services.
PUBLIC_HOST=invoices.example.com
PUBLIC_ORIGIN=https://invoices.example.com
POSTGRES_DB=invoicedesk
POSTGRES_USER=invoicedesk
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql+psycopg://invoicedesk:replace-with-a-long-unique-password@db:5432/invoicedesk
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=replace-with-registered-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_ALLOWED_USERS={"replace-with-stable-oidc-subject":["admin","reviewer","uploader"]}
LLM_MODE=live
LLM_PROVIDER=openai
# Supply an evaluated dated snapshot in BOTH settings; aliases fail startup.
LLM_MODEL=replace-with-evaluated-dated-model
INVOICEDESK_EVALUATED_MODEL=replace-with-evaluated-dated-model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_CACHE_DIR=/private/extraction-cache
DOCUMENT_ROOT=/private/documents
DOCUMENT_RETENTION_DAYS=365
INVOICEDESK_PARSER=pdfplumber
INVOICEDESK_MATCHER=rapidfuzz
LOG_TO_FILE=false
LOG_TO_CONSOLE=true
